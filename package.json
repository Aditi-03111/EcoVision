{
  "name": "ecovision",
  "version": "1.0.0",
  "private": true,
  "description": "AI-based wildlife monitoring prototype for camera-trap detection, animal re-identification, and poaching event review.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:backend\" \"npm:frontend\"",
    "backend": "node backend/index.js",
    "frontend": "vite --host 127.0.0.1",
    "server": "node backend/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/**/*.test.js",
    "start": "node backend/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.544.0",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "vite": "^7.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {}
}
